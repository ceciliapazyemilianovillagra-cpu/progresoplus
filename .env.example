# Cargá estas variables en Vercel (Project Settings → Environment Variables).

# Connection string de Supabase (Project Settings → Database → Connection string → Transaction pooler).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:contraseña@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# Secreto para firmar las cookies de sesión. Generalo con: openssl rand -hex 32
SESSION_SECRET=

# API key de Gemini (https://aistudio.google.com/apikey) para analyze-food y analyze-wellbeing.
GEMINI_API_KEY=

# Opcional: límite diario de eventos de IA antes de mostrar warning (default 20).
AI_DAILY_WARNING_LIMIT=20
